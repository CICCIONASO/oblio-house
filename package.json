{
  "name": "oblio-house",
  "version": "0.14.0",
  "private": true,
  "description": "L'app del reparto: farmacia, ticket, cassa, scorte, freccette e classifiche.",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:pure && npm run test:novita && npm run test:sync && npm run test:compat && npm run test:versione",
    "test:pure": "node test/pure.test.js",
    "test:novita": "node test/novita.test.js",
    "test:sync": "node test/sync.test.js",
    "test:compat": "node test/compat.test.js",
    "test:versione": "node test/versione.test.js",
    "test:e2e": "node build.js && node test/e2e.js",
    "coverage": "c8 --all=false --include=.copertura/app.js --reporter=text --reporter=text-summary npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  }
}
